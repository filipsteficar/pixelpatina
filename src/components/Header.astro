---
// Data
import { mainMenu } from "@/utils/global";
// Icons
import { Menu as Hamburger, X } from "@lucide/astro";
// Get Current Path
const currentPath = Astro.url.pathname;
---
<!-- Header -->
<!-- x-data initializes Alpine's reactive scope on this element. Any child element can now read/write `menuOpen`. -->
<header 
x-data={`{menuOpen: false, currentPath: '${currentPath.replace(/\/$/, "") || "/"}'}`}
class="border-isabelline-900 border-b-2 font-vt323 text-[calc(var(--text-fl-base)*var(--vt323-scale))]"
>
    <!-- Desktop Navigation / Menu -->
    <nav class="flex flex-row flex-wrap justify-between items-center mx-auto p-fl-base container">
        <a href="/" class="hover:text-cinnamon-300 uppercase">Pixel <span class="text-rust-400">Patina</span></a>
        <ul class="hidden md:flex flex-row flex-wrap gap-fl-base">
            {mainMenu?.map((item) => (
            <li class="hover:text-cinnamon-300 uppercase">
                <a
                :class="{ 'text-patina-400': currentPath === $el.dataset.href }"
                data-href={item.href}
                href={item.href || "/"}
                >
                    {item.label || "Unknown"}
                </a>
            </li>
            ))}
        </ul>
        <!-- The toggle button wraps both icons. @click is Alpine shorthand for x-on:click - it flips menuOpen. aria-expanded reflects state for accessibility. -->
        <button
        @click="menuOpen = !menuOpen"
        :aria-expanded="menuOpen"
        aria-label="Toggle mobile navigation menu"
        class="md:hidden cursor-pointer"
        >
        <!-- x-show toggles display:none. x-transition adds Alpine's default fade+scale animation. The two icons are layered in the same space via absolute positioning, so they cross-fade instead of jumping layout. -->
        <!-- Hamburger / X Icon For Opening or Closing The Mobile Menu -->
        <span 
        class="relative flex justify-center items-center w-6 h-6 transition-transform duration-250 ease-in-out"
        :class="menuOpen ? 'rotate-180 scale-150' : 'rotate-0 scale-100'"
        >
            <span x-show="!menuOpen" x-transition class="absolute inset-0 flex justify-center items-center">
                <Hamburger />
            </span>
            
            <span x-show="menuOpen" x-transition class="absolute inset-0 flex justify-center items-center">
                <X />
            </span>
        </span>
    </button>
    </nav>
    <!-- Mobile Navigation / Menu -->
    <!-- x-show toggles the mobile menu. x-transition:enter / x-transition:leave gives us Tailwind-class-based transitions. This slides the menu down from the top by transitioning opacity + translate. -->
    <div
    x-show="menuOpen"
    x-transition:enter="transition ease-in-out duration-250"
    x-transition:enter-start="opacity-0 -translate-y-2"
    x-transition:enter-end="opacity-100 translate-y-0"
    x-transition:leave="transition ease-in-out duration-250"
    x-transition:leave-start="opacity-100 translate-y-0"
    x-transition:leave-end="opacity-0 -translate-y-2"
    class="md:hidden z-10 flex flex-col border-isabelline-900 border-t-2"
    role="menu"
    aria-label="Mobile navigation menu"
    >
        <div class="mx-auto p-fl-base container">
            <ul class="flex flex-col gap-fl-base">
                {mainMenu?.map((item) => (
                <li class="uppercase" role="none">
                    <a 
                    role="menuitem"
                    class="block bg-isabelline-900/50 hover:bg-isabelline-900 focus:bg-isabelline-900 p-fl-sm rounded-lg focus:outline-none focus:ring-2 focus:ring-isabelline-500 hover:text-cinnamon-300 transition-all duration-250 ease-in-out"
                    :class="{ 'text-patina-400': currentPath === $el.dataset.href }"
                    data-href={item.href}
                    href={item.href || "/"}>{item.label || "Unknown"}</a>
                </li>
                ))}
            </ul>
        </div>
    </div>
</header>