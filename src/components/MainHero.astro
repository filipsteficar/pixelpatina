---
// Components
import { Image } from 'astro:assets';
import ActionButton from "@/components/ActionButton.astro";
import SecondaryButton from "@/components/SecondaryButton.astro";
// Images
import bg1 from "@/images/design/bg.webp";
---
<div class="items-center gap-fl-base grid grid-cols-1 lg:grid-cols-2 mx-auto px-fl-base container">
    <div class="flex flex-col gap-fl-base">
        <h1>Lorem ipsum dolor, sit amet consectetur adipisicing elit.</h1>
        <p>Lorem ipsum dolor sit amet, consectetur adipisicing elit. Consequatur architecto odit vero dolorum? Soluta animi, accusantium nobis repellendus nemo ex eligendi. Provident, molestias praesentium.</p>
        <div class="gap-fl-base grid grid-cols-1 lg:grid-cols-2">
            <ActionButton
            buttonText="Join Community"
            href="/community"
            />
            <SecondaryButton
            buttonText="Visit Blog"
            href="/blog"
            />
        </div>
    </div>
    <div>
        <Image src={bg1} alt="Test Alt Description" class="rounded-md object-cover aspect-3/2" />
    </div>
</div>