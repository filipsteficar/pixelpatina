---
import { siteData } from "@/utils/global";
---
<!-- Meta -->
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" href="/favicon.ico" />
<meta name="generator" content={Astro.generator} />
<!-- Sitemap -->
<link rel="sitemap" href="/sitemap-index.xml" />
<!-- Site Title -->
<title>{siteData.website}</title>
<!-- Umami Analytics -->
<script defer src="https://umami.blackpearl.altkod.com/script.js" data-website-id="34ad2686-b96e-4566-8647-8cb97394e031"></script>
<!-- Preload Fonts -->
<link
rel="preload"
href="/fonts/Satoshi-Variable.woff2"
as="font"
type="font/woff"
crossorigin="anonymous"
/>
<link
rel="preload"
href="/fonts/VT323-Regular.woff2"
as="font"
type="font/woff"
crossorigin="anonymous"
/>